{
  "name": "samedayprop",
  "version": "0.1.0",
  "private": true,
  "description": "Instant-funded simulated futures prop-firm platform (development build).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset --skip-generate && npm run db:seed",
    "worker": "tsx src/server/jobs/worker-entry.ts",
    "setup": "prisma generate && prisma db push --skip-generate && npm run db:seed"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "^1.63.0",
    "postcss": "8.5.28",
    "prisma": "^6.19.3",
    "sharp": "^0.35.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
