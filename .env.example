# Copy to .env and fill in. NEVER commit .env.
# Values here are examples and placeholders — no real secret belongs in this file.

# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------
# DEMO       everything mocked, banner shown, no real money, no real email
# SANDBOX    provider sandboxes with test credentials
# PRODUCTION real customers and real money
#
# PRODUCTION REFUSES TO START without a configured payment provider, trading
# provider and email provider. A mock in production would take real money
# through a fake checkout and provision nothing.
APP_MODE=DEMO

# ---------------------------------------------------------------------------
# Site password (optional)
# ---------------------------------------------------------------------------
# Holds the WHOLE site behind one shared password, so a deployment can be shared
# with a few people without being public. Leave blank and the site is open.
#
# This is a curtain, not a security boundary: everyone who gets in shares one
# secret. It does not replace per-customer login, and it is not a reason to put
# real customer data on a deployment.
SITE_PASSWORD=

# Optional on a host that injects its own URL (Vercel sets VERCEL_URL and
# VERCEL_PROJECT_PRODUCTION_URL, which are used automatically). Set it when you
# have a custom domain, so links and emails point at the real one.
APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Development uses SQLite. Production targets PostgreSQL: change the provider
# in prisma/schema.prisma and use a postgresql:// URL here.
# Use SEPARATE databases for demo, sandbox and production.
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Session security
# ---------------------------------------------------------------------------
# Required outside DEMO, AND for any hosted deployment including a DEMO one:
# the built-in demo fallback is a constant in this public repository, so a
# deployment using it can have its session cookies forged by anyone.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Force secure cookies in local development (normally implied outside DEMO).
# FORCE_SECURE_COOKIES=1

# ---------------------------------------------------------------------------
# Credential encryption
# ---------------------------------------------------------------------------
# Encrypts the show-once platform password at rest between provisioning and the
# moment the trader acknowledges it. REQUIRED in production: without it the
# session secret is reused, so one leaked key would open both sessions and
# credentials. Generate with: openssl rand -base64 48
CREDENTIAL_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Company identity — PLACEHOLDERS
# ---------------------------------------------------------------------------
# Legal documents cannot be finalised and production cannot be enabled until
# these are real. Leaving them unset marks the company details incomplete and
# blocks the launch gate.
COMPANY_NAME=
COMPANY_LEGAL_ENTITY=
COMPANY_JURISDICTION=
COMPANY_SUPPORT_EMAIL=
COMPANY_POSTAL_ADDRESS=

# ---------------------------------------------------------------------------
# Payment provider
# ---------------------------------------------------------------------------
# Leave blank to use the clearly-labelled mock. Setting these selects the hosted
# adapter, which is NOT YET IMPLEMENTED — implement it against the provider you
# have actually contracted with, using a hosted or tokenised payment page so
# card data never reaches this application.
PAYMENTS_PUBLIC_KEY=
PAYMENTS_SECRET_KEY=
PAYMENTS_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Trading provider (Tradovate)
# ---------------------------------------------------------------------------
# Leave blank to use the mock. Setting these selects the real adapter, whose
# every capability is currently UNVERIFIED and throws by design.
# See docs/TRADOVATE_CAPABILITIES.md before setting these.
TRADOVATE_BASE_URL=
TRADOVATE_API_KEY=

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Leave blank to write to the local outbox (.outbox/ and the EmailOutbox table)
# instead of sending. The SMTP transport is not implemented: supply the company
# sending identity first, or mail will misidentify its sender.
SMTP_URL=
